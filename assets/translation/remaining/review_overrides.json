{
  "schema": "eternal-lovers-remaining-review-overrides/v1",
  "index_sha256": "532d2e7dd194537922c9e7d373309fe32cac105b7a986bd522bdf377513f7df6",
  "reviewed_through": 6260,
  "entries": [
    {"id": "remaining:00402", "translation": "1번기, 하이퍼 캐논, 발사합니다～\n"},
    {"id": "remaining:04863", "translation": "……네……?\n"},
    {"id": "remaining:04901", "translation": "저를 초대해 주신 것도…… 택트\n"},
    {"id": "remaining:04980", "translation": "러브레터 덕분에, 불안이 한꺼번에 날아\n"},
    {"id": "remaining:04981", "translation": "가 버렸습니다.\n"},
    {"id": "remaining:04993", "translation": "이제 더 이상, 누구도 슬프게 하\n"},
    {"id": "remaining:04994", "translation": "고 싶지 않습니다.\n"},
    {"id": "remaining:05000", "translation": "저는 절대로 지지 않겠습니다!\n"},
    {"id": "remaining:05014", "translation": "작은 희망, 저는 그것을 믿습니다.\n"},
    {"id": "remaining:05024", "translation": "택트 씨와 둘이라면…… 분명\n"},
    {"id": "remaining:05025", "translation": "무슨 일이든 할 수 있습니다.\n"},
    {"id": "remaining:05040", "translation": "하도록 힘쓰겠습니다.\n"},
    {"id": "remaining:05044", "translation": "있어요.\n"},
    {"id": "remaining:05059", "translation": "엇갈리고 마는 걸까요…….\n"},
    {"id": "remaining:05061", "translation": "가장 소중한 사람만 보고 있어야 해요.\n"},
    {"id": "remaining:05070", "translation": "게른이 바라는 세상이 된다면,\n"},
    {"id": "remaining:05095", "translation": "이 은하를 지켜내겠습니다!\n"},
    {"id": "remaining:05111", "translation": "슬슬 물러날 때인가……?\n"},
    {"id": "remaining:05119", "translation": "손상이 너무 심하다!\n"},
    {"id": "remaining:05143", "translation": "내 함선의 위엄을 보았느냐, 인간.\n"},
    {"id": "remaining:05158", "translation": "흠, 피했나.\n"},
    {"id": "remaining:05167", "translation": "그 정도의 공격으로 나를 막으려 하다니, 가소롭\n"},
    {"id": "remaining:05168", "translation": "기 짝이 없군.\n"},
    {"id": "remaining:05169", "translation": "무의미한 공격을…… 아무리 발버둥쳐도,\n"},
    {"id": "remaining:05178", "translation": "못한다.\n"},
    {"id": "remaining:05190", "translation": "가증스러운 EDEN의 후예 녀석.\n"},
    {"id": "remaining:05193", "translation": "인간 따위에게 허를 찔리다니…….\n"},
    {"id": "remaining:05208", "translation": "이 기세로 부탁해, 『누나』.\n"},
    {"id": "remaining:05217", "translation": "모…… 목표에 착탄…… 예상대로입니다.\n"},
    {"id": "remaining:05224", "translation": "피했나…… 조금만 수명이 늘어\n"},
    {"id": "remaining:05240", "translation": "으윽! 피…… 피탄……했습니다.\n"},
    {"id": "remaining:05257", "translation": "슬슬 물러날 때인가.\n"},
    {"id": "remaining:05260", "translation": "……비상…… 즉시 전투를\n"},
    {"id": "remaining:05265", "translation": "여자, 후퇴다.\n"},
    {"id": "remaining:05277", "translation": "더없이 좋구나.\n"},
    {"id": "remaining:05278", "translation": "짐에게 다가오면 멸망할 줄 알고 있었을 터\n"},
    {"id": "remaining:05279", "translation": "인데…… 어리석도다.\n"},
    {"id": "remaining:05295", "translation": "에게는 나중에 벌을 줄 필요가 있겠군.\n"},
    {"id": "remaining:05301", "translation": "어찌 된 일이냐, 피하기만 해서는 아무것도\n"},
    {"id": "remaining:05302", "translation": "되지 않느냐?\n"},
    {"id": "remaining:05303", "translation": "제법 하는구나.\n"},
    {"id": "remaining:05305", "translation": "오오, 이 함선이 흔들렸구나.\n"},
    {"id": "remaining:05306", "translation": "칭찬해 주마.\n"},
    {"id": "remaining:05307", "translation": "제법인 공격이었으나, 그것으로는 짐을\n"},
    {"id": "remaining:05363", "translation": "유・사쿠라바\n"},
    {"id": "remaining:05375", "translation": "뭔가 납득은 안 되지만…… 어쨌든\n"},
    {"id": "remaining:05395", "translation": "마이어스 사령관, 큰일입니다!\n"},
    {"id": "remaining:05396", "translation": "새로운 적이 다수, 접근해 옵니다!\n"},
    {"id": "remaining:05400", "translation": "엄청난 수군…….\n"},
    {"id": "remaining:05414", "translation": "됐나?\n"},
    {"id": "remaining:05417", "translation": "이쪽은 문장기로 싸우는 건 처음이라,\n"},
    {"id": "remaining:05421", "translation": "네가 부정하는 「마음」의 힘…… 보여주\n"},
    {"id": "remaining:05422", "translation": "겠어. 나도 엔젤대도, 너에게 질\n"},
    {"id": "remaining:05423", "translation": "수는 없어!\n"},
    {"id": "remaining:05431", "translation": "마, 마이어스 사령관!\n"},
    {"id": "remaining:05434", "translation": "설마…… 벌써 충전이 끝난 건\n"},
    {"id": "remaining:05435", "translation": "가!?\n"},
    {"id": "remaining:05445", "translation": "좋아, 지금이 기회다. 서둘러 이탈하자!\n"},
    {"id": "remaining:05446", "translation": "알겠습니다! 엔진 전속!\n"},
    {"id": "remaining:05454", "translation": "줘!\n"},
    {"id": "remaining:05467", "translation": "전 함대에 전달, 적 요새에 공격 개시!\n"},
    {"id": "remaining:05482", "translation": "가 다시 나타났나…….\n"},
    {"id": "remaining:05486", "translation": "『발・파스크』 함대, 후퇴하고\n"},
    {"id": "remaining:05487", "translation": "있습니다.\n"},
    {"id": "remaining:05536", "translation": "떠나자.\n"},
    {"id": "remaining:05548", "translation": "밀피가 적에게 당하게 둘 것 같아\n"},
    {"id": "remaining:05549", "translation": "요!\n"},
    {"id": "remaining:05555", "translation": "이, 이제 안 돼요!\n"},
    {"id": "remaining:05557", "translation": "택트 씨, 도와줘요, 택트 씨ー!\n"},
    {"id": "remaining:05558", "translation": "아직 택트 씨 이야기를 듣지 못했는\n"},
    {"id": "remaining:05559", "translation": "데…… 택트 씨와, 좀 더 좀 더,\n"},
    {"id": "remaining:05561", "translation": "싫어어어어어어어엇……!!\n"},
    {"id": "remaining:05563", "translation": "……무, 문장기의…… 반응이…… 사라집니다\n"},
    {"id": "remaining:05588", "translation": "택트 씨…… 저, 계속 생각해 온 게\n"},
    {"id": "remaining:05589", "translation": "있어요.\n"},
    {"id": "remaining:05608", "translation": "남아 있는 적 함대는 퇴각을 시작한 모양\n"},
    {"id": "remaining:05609", "translation": "입니다.\n"},
    {"id": "remaining:05614", "translation": "게다가, 크로노・퀘이크 폭탄을 멈출\n"},
    {"id": "remaining:05615", "translation": "수단도…… 이걸로 영원히 사라졌다.\n"},
    {"id": "remaining:05636", "translation": "부근의 함선은 즉시 대피!\n"},
    {"id": "remaining:05639", "translation": "계, 계측 불능입니다!!\n"},
    {"id": "remaining:05649", "translation": "라, 란파…….\n"},
    {"id": "remaining:05655", "translation": "본때를 보여줄 테니까!\n"},
    {"id": "remaining:05667", "translation": "택트ー!\n"},
    {"id": "remaining:05671", "translation": "사랑해, 사랑해, 사랑해 사랑\n"},
    {"id": "remaining:05672", "translation": "해 사랑해 사랑해 사랑해……!\n"},
    {"id": "remaining:05673", "translation": "아아아아아아아아아……!!\n"},
    {"id": "remaining:05733", "translation": "택트 씨…… 저, 계속 생각해 온\n"},
    {"id": "remaining:05734", "translation": "게 있어요…….\n"},
    {"id": "remaining:05735", "translation": "아무리 생각해도 답이 나오지 않아서, 이제,\n"},
    {"id": "remaining:05736", "translation": "어떻게 해야 좋을지 전혀 모르\n"},
    {"id": "remaining:05737", "translation": "겠더라고요…….\n"},
    {"id": "remaining:05743", "translation": "바로 저의 가장 사랑하는 사람이니까요.\n"},
    {"id": "remaining:05750", "translation": "저 소형선도 반드시 구해낼 테니\n"},
    {"id": "remaining:05751", "translation": "까, 잘 지켜보라고.\n"},
    {"id": "remaining:05760", "translation": "어찌 됐든, 질 수는 없\n"},
    {"id": "remaining:05766", "translation": "택트 씨, 선배들, 서둘러요.\n"},
    {"id": "remaining:05770", "translation": "네, 포르테 선배에게 적이 접근하게 하지는\n"},
    {"id": "remaining:05773", "translation": "……뭐, 이게 마지막이 될 것 같지\n"},
    {"id": "remaining:05774", "translation": "만 말이야……\n"},
    {"id": "remaining:05775", "translation": "적 씨들, 나한테 볼일이 있는 모양이네.\n"},
    {"id": "remaining:05776", "translation": "모두…… 너희와 만나서 최고\n"},
    {"id": "remaining:05777", "translation": "였어. 항상 정신없긴 했지만,\n"},
    {"id": "remaining:05804", "translation": "조금이라도 도움이 되도록, 힘내겠습니다.\n"},
    {"id": "remaining:05815", "translation": "그렇죠, 택트 씨?\n"},
    {"id": "remaining:05830", "translation": "게 있습니다…….\n"},
    {"id": "remaining:05847", "translation": "하지 말아 줘.\n"},
    {"id": "remaining:05864", "translation": "저…… 저, 아직 택트 씨에게 말하지 못\n"},
    {"id": "remaining:05865", "translation": "한 게……! 택트 씨…… 저는…… 당신\n"},
    {"id": "remaining:05866", "translation": "을……!\n"},
    {"id": "remaining:05876", "translation": "택트 씨…… 이 싸움, 아직 계속되는 건가요?\n"},
    {"id": "remaining:06114", "translation": "\t\t\t\t\t텍스처 필터를 Anisotropic으로 설정했을 때의 품질을 설정합니다.\n"},
    {"id": "remaining:06117", "translation": "\t\t\t\t\tOn으로 설정하면 동작 속도가 향상되는 경우가 있으나, 렌더링 품질은 떨어집니다.\n"},
    {"id": "remaining:06125", "translation": "\t\t\t\t\t사용할 렌더링 처리 레벨을 설정합니다.\n"}
  ]
}
