    {
      "id": "SCENARIO_DAT_00276000:isb:0014",
      "context": {
        "voice": "GC928010.ogg"
      },
      "original": "こっちの艦は、機動力を重視した駆逐艦タイプだな。",
      "translation": "이쪽 함선은 기동력을 중시한 구축함 타입이군.\n",
      "state": "draft",
      "use_translation": true,
      "storage": [
        {
          "offset": 2672,
          "length": 40,
          "key": 2700647969,
          "original": "こっちの艦は、機動力を重視した駆逐艦タイ"
        },
