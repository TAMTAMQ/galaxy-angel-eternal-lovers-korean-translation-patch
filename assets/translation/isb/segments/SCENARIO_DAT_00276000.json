    {
      "id": "SCENARIO_DAT_00276000:isb:0008",
      "context": {
        "voice": "GC928005.ogg"
      },
      "original": "あ、はい、今終わったところです。",
      "translation": "아, 네, 방금 끝난 참입니다.\n",
      "state": "draft",
      "use_translation": true,
      "storage": [
        {
          "offset": 1416,
          "length": 32,
          "key": 2700647969,
          "original": "あ、はい、今終わったところです。"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_00276000:isb:0009",
      "context": {
        "voice": "GC928005.ogg"
      },
      "original": "よし、こちらに回してくれ。",
      "translation": "좋아, 이쪽으로 보내줘.\n",
      "state": "draft",
      "use_translation": true,
      "storage": [
        {
          "offset": 1520,
          "length": 26,
          "key": 2700647969,
          "original": "よし、こちらに回してくれ。"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_00276000:isb:0010",
      "context": {
        "voice": "GC928006.ogg"
      },
      "original": "はい、メインモニターに出します。",
      "translation": "네, 메인 모니터로 띄우겠습니다.\n",
      "state": "draft",
      "use_translation": true,
      "storage": [
        {
          "offset": 1660,
          "length": 32,
          "key": 2700647969,
          "original": "はい、メインモニターに出します。"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_00276000:isb:0011",
      "context": {
        "voice": "GC928007.ogg"
      },
      "original": "確認されている敵は３種類だな。まずは、この艦だ。",
      "translation": "확인된 적은 ３종류군. 우선 이 함선이다.\n",
      "state": "draft",
      "use_translation": true,
      "storage": [
        {
          "offset": 1856,
          "length": 40,
          "key": 2700647969,
          "original": "確認されている敵は３種類だな。まずは、こ"
        },
        {
          "offset": 1904,
          "length": 8,
          "key": 2700647969,
          "original": "の艦だ。"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_00276000:isb:0012",
      "context": {
        "voice": "GC928008.ogg"
      },
      "original": "質量、速力から見て、巡洋艦タイプといったところだな。攻撃力と速度を兼ね備えているようだ。油断するなよ。",
      "translation": "질량과 속력으로 보아 순양함 타입이겠군. 공격력과 속도를 겸비한 듯하다. 방심하지 마라.\n",
      "state": "draft",
      "use_translation": true,
      "storage": [
        {
          "offset": 2080,
          "length": 40,
          "key": 2700647969,
          "original": "質量、速力から見て、巡洋艦タイプといった"
        },
        {
          "offset": 2128,
          "length": 40,
          "key": 2700647969,
          "original": "ところだな。攻撃力と速度を兼ね備えている"
        },
        {
          "offset": 2176,
          "length": 22,
          "key": 2700647969,
          "original": "ようだ。油断するなよ。"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_00276000:isb:0013",
      "context": {
        "voice": "GC928009.ogg"
      },
      "original": "次は、この小型艦だ。",
      "translation": "다음은 이소형함이다.",
      "state": "shortened",
      "use_translation": true,
      "storage": [
        {
          "offset": 2484,
          "length": 20,
          "key": 2700647969,
          "original": "次は、この小型艦だ。"
        }
