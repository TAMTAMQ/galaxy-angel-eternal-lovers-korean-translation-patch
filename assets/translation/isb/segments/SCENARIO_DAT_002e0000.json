      "state": "draft",
      "use_translation": true,
      "storage": [
        {
          "offset": 1292,
          "length": 22,
          "key": 1974296460,
          "original": "ところで、タクトさん。"
        },
        {
          "offset": 1324,
          "length": 40,
          "key": 1974296460,
          "original": "宇宙クジラに、エンジェル隊のみなさんの気"
