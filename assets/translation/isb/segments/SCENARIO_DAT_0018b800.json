    {
      "id": "SCENARIO_DAT_0018b800:isb:0016",
      "context": {
        "voice": "GC958011.ogg"
      },
      "original": "タクト、どうする？　７番機を狙うか？",
      "translation": "택트, 어떻게할거야？７번기를노릴까？",
      "state": "shortened",
      "use_translation": true,
      "storage": [
        {
          "offset": 3596,
          "length": 36,
          "key": 2526071291,
          "original": "タクト、どうする？　７番機を狙うか？"
