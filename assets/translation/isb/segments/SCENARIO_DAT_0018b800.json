    {
      "id": "SCENARIO_DAT_0018b800:isb:0019",
      "context": {
        "voice": "GC958012.ogg"
      },
      "original": "マイヤーズ司令、敵の増援部隊がこちらに接近中です。",
      "translation": "마이어스 사령관, 적 증원 부대가 접근 중입니다.",
      "state": "shortened",
      "use_translation": true,
      "storage": [
        {
          "offset": 4108,
          "length": 40,
          "key": 2526071291,
          "original": "マイヤーズ司令、敵の増援部隊がこちらに接"
        },
        {
          "offset": 4156,
          "length": 10,
          "key": 2526071291,
          "original": "近中です。"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_0018b800:isb:0020",
      "context": {
        "voice": "GC958012.ogg"
      },
      "original": "そうか。下手に戦闘を長引かせると、不利になる可能性が高いな……。気をつけよう。",
      "translation": "그런가. 어설프게 전투를 끌면 불리해질 가능성이 높겠군…… 주의하자.\n",
      "state": "draft",
      "use_translation": true,
      "storage": [
        {
          "offset": 4240,
          "length": 40,
          "key": 2526071291,
          "original": "そうか。下手に戦闘を長引かせると、不利に"
        },
        {
          "offset": 4288,
          "length": 38,
          "key": 2526071291,
          "original": "なる可能性が高いな……。気をつけよう。"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_0018b800:isb:0021",
      "context": {
        "voice": "GC958012.ogg"
      },
      "original": "ようやくＥＤＥＮにたどり着いたんだ。みんな、存分に戦ってくれ。以上だ。",
      "translation": "겨우 EDEN에 도착했다. 모두, 마음껏 싸워줘라. 이상이다.\n",
      "state": "draft",
      "use_translation": true,
      "storage": [
        {
          "offset": 4428,
          "length": 40,
          "key": 2526071291,
          "original": "ようやくＥＤＥＮにたどり着いたんだ。みん"
        },
        {
          "offset": 4476,
          "length": 30,
          "key": 2526071291,
          "original": "な、存分に戦ってくれ。以上だ。"
        }
