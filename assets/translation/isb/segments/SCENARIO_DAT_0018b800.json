    },
    {
      "id": "SCENARIO_DAT_0018b800:isb:0017",
      "context": {
        "voice": "GC958011.ogg"
      },
      "original": "いや、それだけじゃだめだ。",
      "translation": "아니, 그것만으로는 안 돼.\n",
      "state": "draft",
      "use_translation": true,
      "storage": [
        {
          "offset": 3724,
          "length": 26,
          "key": 2526071291,
          "original": "いや、それだけじゃだめだ。"
        }
