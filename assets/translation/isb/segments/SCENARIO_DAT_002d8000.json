          "length": 8,
          "key": 820214268,
          "original": "か……。"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_002d8000:isb:0010",
      "context": {
        "voice": "GC178006.ogg"
      },
      "original": "なんにせよ、ゲルンを倒さなければ、オレたちに……いや、この銀河に未来はないんだ。",
      "translation": "어쨌든 게른을 쓰러뜨리지 않으면 우리에게…… 아니, 이 은하에 미래는 없다.\n",
      "state": "draft",
      "use_translation": true,
      "storage": [
        {
          "offset": 2116,
          "length": 40,
          "key": 820214268,
          "original": "なんにせよ、ゲルンを倒さなければ、オレた"
        },
        {
          "offset": 2164,
          "length": 40,
          "key": 820214268,
          "original": "ちに……いや、この銀河に未来はないんだ。"
        }
