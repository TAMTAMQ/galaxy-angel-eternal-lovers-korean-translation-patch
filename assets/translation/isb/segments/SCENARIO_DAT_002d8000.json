    },
    {
      "id": "SCENARIO_DAT_002d8000:isb:0007",
      "context": {
        "voice": "GC958004.ogg"
      },
      "original": "敵艦隊の配置は、こうなっている。",
      "translation": "적 함대의 배치는 이렇다.\n",
      "state": "reused",
      "use_translation": true,
      "storage": [
        {
          "offset": 1328,
          "length": 32,
          "key": 820214268,
          "original": "敵艦隊の配置は、こうなっている。"
        }
