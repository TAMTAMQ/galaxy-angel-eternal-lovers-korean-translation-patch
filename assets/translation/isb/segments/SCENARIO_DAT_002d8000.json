    },
    {
      "id": "SCENARIO_DAT_002d8000:isb:0005",
      "context": {
        "voice": "GC938002.ogg"
      },
      "original": "エルシオールの現在位置は、ここだ。",
      "translation": "에르시올의 현재 위치는, 여기다.",
      "state": "reused",
      "use_translation": true,
      "storage": [
        {
          "offset": 788,
          "length": 34,
          "key": 820214268,
          "original": "エルシオールの現在位置は、ここだ。"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_002d8000:isb:0006",
      "context": {
        "voice": "GC958003.ogg"
      },
      "original": "援護の友軍艦隊はこの位置にいる。",
      "translation": "지원할 우군 함대는 이위치에있다.",
      "state": "shortened",
      "use_translation": true,
      "storage": [
        {
          "offset": 1060,
          "length": 32,
          "key": 820214268,
          "original": "援護の友軍艦隊はこの位置にいる。"
        }
