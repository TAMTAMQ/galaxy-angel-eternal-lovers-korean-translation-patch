      ]
    },
    {
      "id": "SCENARIO_DAT_002c4800:isb:0005",
      "context": {
        "voice": "GC938002.ogg"
      },
      "original": "エルシオールの現在位置は、ここだ。",
      "translation": "에르시올의 현재 위치는, 여기다.",
      "state": "reused",
      "use_translation": true,
      "storage": [
        {
          "offset": 792,
          "length": 34,
          "key": 1954199744,
          "original": "エルシオールの現在位置は、ここだ。"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_002c4800:isb:0006",
      "context": {
        "voice": "GC958003.ogg"
      },
      "original": "援護の友軍艦隊はこの位置にいる。",
      "translation": "지원할 우군 함대는 이위치에있다.",
      "state": "shortened",
      "use_translation": true,
      "storage": [
        {
          "offset": 1064,
          "length": 32,
          "key": 1954199744,
          "original": "援護の友軍艦隊はこの位置にいる。"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_002c4800:isb:0007",
      "context": {
        "voice": "GC958004.ogg"
      },
      "original": "敵艦隊の配置は、こうなっている。",
      "translation": "적 함대의 배치는 이렇다.\n",
      "state": "reused",
      "use_translation": true,
      "storage": [
        {
          "offset": 1332,
          "length": 32,
          "key": 1954199744,
          "original": "敵艦隊の配置は、こうなっている。"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_002c4800:isb:0008",
      "context": {
        "voice": "GC968005.ogg"
      },
      "original": "それから、大型のミサイル……機動爆雷が、スカイパレスに接近中だ。",
      "translation": "그리고, 대형 미사일…… 기동 폭뢰가 스카이팔레스에 접근 중이다.\n",
      "state": "draft",
      "use_translation": true,
      "storage": [
        {
          "offset": 1752,
          "length": 40,
          "key": 1954199744,
          "original": "それから、大型のミサイル……機動爆雷が、"
        },
        {
          "offset": 1800,
          "length": 24,
          "key": 1954199744,
          "original": "スカイパレスに接近中だ。"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_002c4800:isb:0009",
      "context": {
        "voice": "GC968006.ogg"
      },
      "original": "何しろこのサイズだ。もし直撃したら、スカイパレスはひとたまりもないだろう。",
      "translation": "무려 이 사이즈다. 만약 직격한다면 스카이팔레스는 순식간에 끝장날 것이다.\n",
      "state": "draft",
      "use_translation": true,
      "storage": [
        {
          "offset": 1992,
          "length": 40,
          "key": 1954199744,
          "original": "何しろこのサイズだ。もし直撃したら、スカ"
        },
        {
          "offset": 2040,
          "length": 34,
          "key": 1954199744,
          "original": "イパレスはひとたまりもないだろう。"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_002c4800:isb:0010",
      "context": {
        "voice": "GC968007.ogg"
      },
      "original": "現在この空域内には、３基の機動爆雷が進入している。",
      "translation": "현재 이 공역에 기동 폭뢰 ３기가 진입 중이다.",
      "state": "shortened",
      "use_translation": true,
      "storage": [
        {
          "offset": 2236,
          "length": 40,
          "key": 1954199744,
          "original": "現在この空域内には、３基の機動爆雷が進入"
        },
        {
          "offset": 2284,
          "length": 10,
          "key": 1954199744,
          "original": "している。"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_002c4800:isb:0011",
      "context": {
        "voice": "GC968008.ogg"
      },
      "original": "が、軌道上の敵艦からは、それ以上の数が発射されたとの報告が来ている。敵の増援には十分注意しろ。",
      "translation": "하지만 궤도상 적함에서 더 많은 수가 발사됐다는 보고가 있다. 적의 증원을 주의하라.",
      "state": "shortened",
      "use_translation": true,
      "storage": [
        {
          "offset": 2428,
          "length": 40,
          "key": 1954199744,
          "original": "が、軌道上の敵艦からは、それ以上の数が発"
        },
        {
          "offset": 2476,
          "length": 40,
          "key": 1954199744,
          "original": "射されたとの報告が来ている。敵の増援には"
        },
        {
          "offset": 2524,
          "length": 14,
          "key": 1954199744,
          "original": "十分注意しろ。"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_002c4800:isb:0012",
      "context": {
        "voice": "GC968008.ogg"
      },
      "original": "よし、さっきも言った通り、機動爆雷の破壊が最優先だ。絶対にこのスカイパレスに近づけないでくれ。",
      "translation": "좋아, 아까 말했듯이 기동 폭뢰 파괴가 최우선이다. 절대로 이 스카이팔레스에 접근시키지 마라.\n",
      "state": "draft",
      "use_translation": true,
      "storage": [
        {
          "offset": 2612,
          "length": 40,
          "key": 1954199744,
          "original": "よし、さっきも言った通り、機動爆雷の破壊"
        },
        {
          "offset": 2660,
          "length": 40,
          "key": 1954199744,
          "original": "が最優先だ。絶対にこのスカイパレスに近づ"
        },
        {
          "offset": 2708,
          "length": 14,
          "key": 1954199744,
          "original": "けないでくれ。"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_002c4800:isb:0013",
      "context": {
        "voice": "GC968008.ogg"
      },
      "original": "以上だ。頼んだぞ、みんな。",
      "translation": "이상이다. 부탁한다, 모두.",
