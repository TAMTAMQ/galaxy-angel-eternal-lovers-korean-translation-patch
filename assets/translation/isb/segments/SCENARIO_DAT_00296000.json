    {
      "id": "SCENARIO_DAT_00296000:isb:0004",
      "context": {
        "voice": "GC938001.ogg"
      },
      "original": "これが現在の状況だ。",
      "translation": "이것이 현재상황이다.",
      "state": "shortened",
