    {
      "id": "SCENARIO_DAT_000e6000:isb:0004",
      "context": {
        "voice": "GC278009.ogg"
      },
      "original": "言うまでもないと思うけど……もちろん、わかってるよね？",
      "translation": "말할 필요도 없겠지만…… 물론, 알고 있겠지？\n",
      "state": "draft",
      "use_translation": true,
      "storage": [
        {
          "offset": 540,
          "length": 40,
          "key": 3616939953,
          "original": "言うまでもないと思うけど……もちろん、わ"
