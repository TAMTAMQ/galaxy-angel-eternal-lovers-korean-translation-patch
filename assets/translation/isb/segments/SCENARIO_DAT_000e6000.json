    },
    {
      "id": "SCENARIO_DAT_000e6000:isb:0006",
      "context": {
        "voice": "GC278011.ogg"
      },
      "original": "いいないいな～。タクトさんもランファも、ふたりですっかり通じ合っちゃって。",
      "translation": "좋네 좋아～. 택트 씨도 란파도, 둘이서 완전히 통해버렸네.\n",
      "state": "draft",
      "use_translation": true,
      "storage": [
        {
          "offset": 892,
          "length": 40,
          "key": 3616939953,
          "original": "いいないいな～。タクトさんもランファも、"
        },
        {
          "offset": 940,
          "length": 34,
