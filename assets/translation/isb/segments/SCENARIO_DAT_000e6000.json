      "state": "shortened",
      "use_translation": true,
      "storage": [
        {
          "offset": 1124,
          "length": 40,
          "key": 3616939953,
          "original": "いちゃつくんだったら、帰りにいくらでもで"
        },
        {
          "offset": 1172,
          "length": 12,
          "key": 3616939953,
          "original": "きるだろう？"
