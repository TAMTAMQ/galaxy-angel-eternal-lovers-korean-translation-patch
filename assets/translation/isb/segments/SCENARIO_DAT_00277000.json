    },
    {
      "id": "SCENARIO_DAT_00277000:isb:0006",
      "context": {
        "voice": "GC938003.ogg"
      },
      "original": "敵艦隊の配置は、こうなっている。",
      "translation": "적 함대의 배치는 이렇다.\n",
      "state": "reused",
      "use_translation": true,
      "storage": [
        {
          "offset": 1060,
          "length": 32,
          "key": 1643006617,
          "original": "敵艦隊の配置は、こうなっている。"
        }
