    },
    {
      "id": "SCENARIO_DAT_002d7000:isb:0008",
      "context": {
        "voice": "GC978005.ogg"
      },
      "original": "敵の中には新型が混じっているようだ。",
      "translation": "적 중에는 신형이 섞여 있는 듯하다.\n",
      "state": "draft",
      "use_translation": true,
      "storage": [
        {
          "offset": 1532,
          "length": 36,
          "key": 1027616845,
          "original": "敵の中には新型が混じっているようだ。"
