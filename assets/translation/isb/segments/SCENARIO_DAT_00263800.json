    {
      "id": "SCENARIO_DAT_00263800:isb:0006",
      "context": {
        "voice": "GC938004.ogg"
      },
      "original": "タクト、どうする？",
      "translation": "택트, 어떡할거야？",
      "state": "shortened",
      "use_translation": true,
      "storage": [
        {
          "offset": 1024,
