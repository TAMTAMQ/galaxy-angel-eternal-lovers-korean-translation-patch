          "original": "そうだ！　月見をしながらなんてのはどうだ"
        },
        {
          "offset": 10476,
          "length": 4,
          "key": 2383170175,
          "original": "い？"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_001fa800:isb:0065",
      "context": {
        "voice": "GC575112.ogg"
      },
      "original": "夜に、という意味ですか……？",
      "translation": "밤에, 라는 뜻인가요……？\n",
      "state": "draft",
      "use_translation": true,
      "storage": [
        {
          "offset": 10628,
          "length": 28,
          "key": 2383170175,
          "original": "夜に、という意味ですか……？"
        }
