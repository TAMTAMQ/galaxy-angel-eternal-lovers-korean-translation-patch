  "units": [
    {
      "id": "SCENARIO_DAT_001fa800:isb:0001",
      "context": {
        "voice": null
      },
      "original": "ヴァニラの部屋・胸を痛めるヴァニラ",
      "translation": "바닐라의 방・가슴 아파하는 바닐라\n",
      "state": "draft",
      "use_translation": true,
      "storage": [
        {
          "offset": 16,
          "length": 34,
          "key": 3071315870,
          "original": "ヴァニラの部屋・胸を痛めるヴァニラ"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_001fa800:isb:0002",
      "context": {
        "voice": null
      },
      "original": "ヴァニラ、入ってもいいかな。",
      "translation": "바닐라, 들어가도 될까.\n",
      "state": "draft",
      "use_translation": true,
      "storage": [
        {
          "offset": 192,
          "length": 28,
          "key": 3071315870,
          "original": "ヴァニラ、入ってもいいかな。"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_001fa800:isb:0003",
      "context": {
        "voice": "GC575000.ogg"
      },
      "original": "タクトさん……なにかご用でしょうか……。",
      "translation": "택트 씨…… 무슨 용건이신가요…….\n",
      "state": "draft",
      "use_translation": true,
      "storage": [
        {
          "offset": 412,
          "length": 40,
          "key": 3071315870,
          "original": "タクトさん……なにかご用でしょうか……。"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_001fa800:isb:0004",
      "context": {
        "voice": "GC575000.ogg"
      },
      "original": "うん、ヴァニラのことが気になってね。",
      "translation": "응, 바닐라가 걱정돼서 말이야.\n",
      "state": "draft",
      "use_translation": true,
      "storage": [
        {
          "offset": 524,
          "length": 36,
          "key": 3071315870,
          "original": "うん、ヴァニラのことが気になってね。"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_001fa800:isb:0005",
      "context": {
        "voice": "GC575001.ogg"
      },
      "original": "そうですか。ありがとうございます……。",
      "translation": "그렇군요. 감사합니다…….\n",
      "state": "draft",
      "use_translation": true,
      "storage": [
        {
          "offset": 672,
          "length": 38,
          "key": 3071315870,
          "original": "そうですか。ありがとうございます……。"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_001fa800:isb:0006",
      "context": {
        "voice": "GC575001.ogg"
      },
      "original": "ヴァニラの思いを聞くなら、たぶんいましかないって思ったんだ。かまわないかい？",
      "translation": "바닐라의 진심을 들으려면, 아마 지금뿐이라고 생각했어. 들어가도 될까？\n",
      "state": "draft",
      "use_translation": true,
      "storage": [
        {
          "offset": 784,
          "length": 40,
          "key": 3071315870,
          "original": "ヴァニラの思いを聞くなら、たぶんいましか"
        },
        {
          "offset": 832,
          "length": 36,
          "key": 3071315870,
          "original": "ないって思ったんだ。かまわないかい？"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_001fa800:isb:0007",
      "context": {
        "voice": "GC575002.ogg"
      },
      "original": "……はい。どうぞ。",
      "translation": "……네.들어오세요.",
      "state": "shortened",
      "use_translation": true,
      "storage": [
        {
          "offset": 980,
          "length": 18,
          "key": 3071315870,
          "original": "……はい。どうぞ。"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_001fa800:isb:0008",
      "context": {
        "voice": "GC575002.ogg"
      },
      "original": "……クロノ・クェイク爆弾のこと、やっぱり気になる？",
      "translation": "…크로노・퀘이크 폭탄에 대해서, 역시 신경 쓰여？",
      "state": "slot-aligned",
      "use_translation": true,
      "storage": [
        {
          "offset": 1072,
          "length": 40,
          "key": 3071315870,
          "original": "……クロノ・クェイク爆弾のこと、やっぱり"
        },
        {
          "offset": 1120,
          "length": 10,
          "key": 3071315870,
          "original": "気になる？"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_001fa800:isb:0009",
      "context": {
        "voice": "GC575003.ogg"
      },
      "original": "そうですね……気になります。",
      "translation": "그렇네요…… 신경 쓰입니다.\n",
      "state": "draft",
      "use_translation": true,
      "storage": [
        {
          "offset": 1280,
          "length": 28,
          "key": 3071315870,
          "original": "そうですね……気になります。"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_001fa800:isb:0010",
      "context": {
        "voice": "GC575003.ogg"
      },
      "original": "怖いかい？",
      "translation": "무서운가？\n",
      "state": "draft",
      "use_translation": true,
      "storage": [
        {
          "offset": 1380,
          "length": 10,
          "key": 3071315870,
          "original": "怖いかい？"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_001fa800:isb:0011",
      "context": {
        "voice": "GC575004.ogg"
      },
      "original": "恐怖はありません……ただ、悲しさを感じます。",
      "translation": "공포는 없습니다… 그저, 슬픔이 느껴집니다.",
      "state": "slot-aligned",
      "use_translation": true,
      "storage": [
        {
          "offset": 1540,
          "length": 40,
          "key": 3071315870,
          "original": "恐怖はありません……ただ、悲しさを感じま"
        },
        {
          "offset": 1588,
          "length": 4,
          "key": 3071315870,
          "original": "す。"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_001fa800:isb:0012",
      "context": {
        "voice": "GC575004.ogg"
      },
      "original": "悲しい、かあ。そう言えるのはヴァニラぐらいのものだろうね。",
      "translation": "슬프다, 인가. 그렇게 말할 수 있는 건 바닐라 정도뿐이겠네.\n",
      "state": "draft",
      "use_translation": true,
      "storage": [
        {
          "offset": 1664,
          "length": 40,
          "key": 3071315870,
          "original": "悲しい、かあ。そう言えるのはヴァニラぐら"
        },
        {
          "offset": 1712,
          "length": 18,
          "key": 3071315870,
          "original": "いのものだろうね。"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_001fa800:isb:0013",
      "context": {
        "voice": "GC575005.ogg"
      },
      "original": "そうなのですか……？",
      "translation": "그런가요……？\n",
      "state": "draft",
      "use_translation": true,
      "storage": [
        {
          "offset": 1880,
          "length": 20,
          "key": 3071315870,
          "original": "そうなのですか……？"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_001fa800:isb:0014",
      "context": {
        "voice": "GC575005.ogg"
      },
      "original": "ほとんどのひとは怖いか嫌い。それでもなければ憎いって答えるかもね。",
      "translation": "대부분은무섭거나 싫어해. 그것도 아니라면증오한다고답할지도모르지.",
      "state": "slot-aligned",
      "use_translation": true,
      "storage": [
        {
          "offset": 1972,
          "length": 40,
          "key": 3071315870,
          "original": "ほとんどのひとは怖いか嫌い。それでもなけ"
        },
        {
          "offset": 2020,
          "length": 26,
          "key": 3071315870,
          "original": "れば憎いって答えるかもね。"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_001fa800:isb:0015",
      "context": {
        "voice": "GC575006.ogg"
      },
      "original": "憎い……のですか？",
      "translation": "증오하는…건가요？",
      "state": "compacted",
      "use_translation": true,
      "storage": [
        {
          "offset": 2196,
          "length": 18,
          "key": 3071315870,
          "original": "憎い……のですか？"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_001fa800:isb:0016",
      "context": {
        "voice": "GC575006.ogg"
      },
      "original": "なにもかもを壊してしまうものに、心の底から腹を立てる。消してしまいたいと思う。それは憎いって感情に近いんじゃないかな？",
      "translation": "모든 걸 파괴하는 것에 마음속 깊이 분노하고, 없애버리고 싶어 하는 것. 그것은 증오라는 감정과 가깝지 않을까？",
      "state": "shortened",
      "use_translation": true,
      "storage": [
        {
          "offset": 2288,
          "length": 40,
          "key": 3071315870,
          "original": "なにもかもを壊してしまうものに、心の底か"
        },
        {
          "offset": 2336,
          "length": 40,
          "key": 3071315870,
          "original": "ら腹を立てる。消してしまいたいと思う。そ"
        },
        {
          "offset": 2384,
          "length": 38,
          "key": 3071315870,
          "original": "れは憎いって感情に近いんじゃないかな？"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_001fa800:isb:0017",
      "context": {
        "voice": "GC575007.ogg"
      },
      "original": "憎しみは人の心を曇らせます。見えるものも……見えなくなってしまいます。",
      "translation": "증오는 사람의 마음을 흐립니다. 보이는 것도…… 보이지않게되어버립니다.",
      "state": "shortened",
      "use_translation": true,
      "storage": [
        {
          "offset": 2572,
          "length": 40,
          "key": 3071315870,
          "original": "憎しみは人の心を曇らせます。見えるものも"
        },
        {
          "offset": 2620,
          "length": 30,
          "key": 3071315870,
          "original": "……見えなくなってしまいます。"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_001fa800:isb:0018",
      "context": {
        "voice": "GC575007.ogg"
      },
      "original": "ヴァニラ……。",
      "translation": "바닐라…….",
      "state": "reused",
      "use_translation": true,
      "storage": [
        {
          "offset": 2724,
          "length": 14,
          "key": 3071315870,
          "original": "ヴァニラ……。"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_001fa800:isb:0019",
      "context": {
        "voice": "GC575008.ogg"
      },
      "original": "タクトさん。私たちは理解し合うことはできないのでしょうか……？",
      "translation": "택트 씨. 우리는 서로 이해할 수 없는 걸까요……？\n",
      "state": "draft",
      "use_translation": true,
      "storage": [
        {
          "offset": 2888,
          "length": 40,
          "key": 3071315870,
          "original": "タクトさん。私たちは理解し合うことはでき"
        },
        {
          "offset": 2936,
          "length": 22,
          "key": 3071315870,
          "original": "ないのでしょうか……？"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_001fa800:isb:0020",
      "context": {
        "voice": "GC575008.ogg"
      },
      "original": "オレたちと『ヴァル・ファスク』とではなにが違うんだろうね。",
      "translation": "우리와 『발・파스크』는 무엇이 다른 걸까.\n",
      "state": "draft",
      "use_translation": true,
      "storage": [
        {
          "offset": 3032,
          "length": 40,
          "key": 3071315870,
          "original": "オレたちと『ヴァル・ファスク』とではなに"
        },
        {
          "offset": 3080,
          "length": 18,
          "key": 3071315870,
          "original": "が違うんだろうね。"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_001fa800:isb:0021",
      "context": {
        "voice": "GC575009.ogg"
      },
      "original": "ヴァインさんは私たちと同じ、人でした……。",
      "translation": "바인 씨는 우리와 같은, 사람이었습니다…….\n",
      "state": "draft",
      "use_translation": true,
      "storage": [
        {
          "offset": 3248,
          "length": 42,
          "key": 3071315870,
          "original": "ヴァインさんは私たちと同じ、人でした……。"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_001fa800:isb:0022",
      "context": {
        "voice": "GC575009.ogg"
      },
      "original": "そうだね。",
      "translation": "그러네.\n",
      "state": "reused",
      "use_translation": true,
      "storage": [
        {
          "offset": 3364,
          "length": 10,
          "key": 3071315870,
          "original": "そうだね。"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_001fa800:isb:0023",
      "context": {
        "voice": "GC575010.ogg"
      },
      "original": "ほんの一時ですが、ＥＤＥＮのルシャーティさんと……分かり合うこともできました。",
      "translation": "잠시였지만, EDEN의 루샤티 씨와…… 마음을 나눌 수도 있었습니다.\n",
      "state": "draft",
      "use_translation": true,
      "storage": [
        {
          "offset": 3488,
          "length": 40,
          "key": 3071315870,
          "original": "ほんの一時ですが、ＥＤＥＮのルシャーティ"
        },
        {
          "offset": 3536,
          "length": 38,
          "key": 3071315870,
          "original": "さんと……分かり合うこともできました。"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_001fa800:isb:0024",
      "context": {
        "voice": "GC575010.ogg"
      },
      "original": "うん。ふたりは確かに心を通わせていたね。",
      "translation": "응. 두 사람은 분명히 마음이통하고있었지.",
      "state": "shortened",
      "use_translation": true,
      "storage": [
        {
          "offset": 3648,
          "length": 40,
          "key": 3071315870,
          "original": "うん。ふたりは確かに心を通わせていたね。"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_001fa800:isb:0025",
      "context": {
        "voice": "GC575011.ogg"
      },
      "original": "けれど、クロノ・クェイク爆弾は、断絶しか生みません……。",
      "translation": "하지만, 크로노・퀘이크 폭탄은 단절만을 낳습니다…….",
      "state": "draft",
      "use_translation": true,
      "storage": [
        {
          "offset": 3836,
          "length": 40,
          "key": 3071315870,
          "original": "けれど、クロノ・クェイク爆弾は、断絶しか"
        },
        {
          "offset": 3884,
          "length": 16,
          "key": 3071315870,
          "original": "生みません……。"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_001fa800:isb:0026",
      "context": {
        "voice": "GC575011.ogg"
      },
      "original": "コミュニケーションがよっぽど嫌いなんだろうね。自分たちに降りかかる被害だってお構いなしだもの。",
      "translation": "커뮤니케이션이 정말 싫은 모양이야. 자신들에게 닥칠 피해는 아랑곳하지 않으니까.\n",
      "state": "draft",
      "use_translation": true,
      "storage": [
        {
          "offset": 3972,
          "length": 40,
          "key": 3071315870,
          "original": "コミュニケーションがよっぽど嫌いなんだろ"
        },
        {
          "offset": 4020,
          "length": 40,
          "key": 3071315870,
          "original": "うね。自分たちに降りかかる被害だってお構"
        },
        {
          "offset": 4068,
          "length": 14,
          "key": 3071315870,
          "original": "いなしだもの。"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_001fa800:isb:0027",
      "context": {
        "voice": "GC575012.ogg"
      },
      "original": "孤独ではないのでしょうか……？",
      "translation": "고독한 것이 아닐까요……？\n",
      "state": "draft",
      "use_translation": true,
      "storage": [
        {
          "offset": 4232,
          "length": 30,
          "key": 3071315870,
          "original": "孤独ではないのでしょうか……？"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_001fa800:isb:0028",
      "context": {
        "voice": "GC575012.ogg"
      },
      "original": "孤独であることに気がついていないかもね。……すまないなあ、ヴァニラ。オレができることってあんまり多くないみたいだ。",
      "translation": "고독하다는 사실을 깨닫지 못하고 있는 걸지도 모르지. ……미안해, 바닐라. 내가 할 수 있는 일은 별로 없는 것 같아.\n",
      "state": "draft",
      "use_translation": true,
      "storage": [
        {
          "offset": 4336,
          "length": 40,
          "key": 3071315870,
          "original": "孤独であることに気がついていないかもね。"
        },
        {
          "offset": 4384,
          "length": 40,
          "key": 3071315870,
          "original": "……すまないなあ、ヴァニラ。オレができる"
        },
        {
          "offset": 4432,
          "length": 34,
          "key": 3071315870,
          "original": "ことってあんまり多くないみたいだ。"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_001fa800:isb:0029",
      "context": {
        "voice": "GC575013.ogg"
      },
      "original": "タクトさん……。",
      "translation": "택트 씨…….\n",
      "state": "reused",
      "use_translation": true,
      "storage": [
        {
          "offset": 4616,
          "length": 16,
          "key": 3071315870,
          "original": "タクトさん……。"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_001fa800:isb:0030",
      "context": {
        "voice": "GC575013.ogg"
      },
      "original": "選べる選択肢は本当にひと握りしかない。それも戦うことだ。ヴァニラのように考え続けるのは、本当に難しいよ。",
      "translation": "선택지는 정말 한 줌뿐이야. 그것도 싸우는 것뿐이지. 바닐라처럼 계속 생각하는 건, 정말 어려운 일이야.",
      "state": "shortened",
      "use_translation": true,
      "storage": [
        {
          "offset": 4704,
          "length": 40,
          "key": 3071315870,
          "original": "選べる選択肢は本当にひと握りしかない。そ"
        },
        {
          "offset": 4752,
          "length": 40,
          "key": 3071315870,
          "original": "れも戦うことだ。ヴァニラのように考え続け"
        },
        {
          "offset": 4800,
          "length": 24,
          "key": 3071315870,
          "original": "るのは、本当に難しいよ。"
        }
      ]
    },
    {
      "id": "SCENARIO_DAT_001fa800:isb:0031",
      "context": {
        "voice": "GC575014.ogg"
